# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Dependencies
vendor/
node_modules/

# Fichiers de test
test_*.php
*_test.php
create_*.php
reset_*.php

