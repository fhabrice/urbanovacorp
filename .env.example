# URBANOVA SOLUTIONS - Environment Configuration

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=urbanova_db
DB_USER=root
DB_PASSWORD=

# Security
SESSION_NAME=urbanova_session
SESSION_LIFETIME=7200

# Email
EMAIL_FROM=contact@urbanova.cd
EMAIL_FROM_NAME=URBANOVA SOLUTIONS
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Upload
UPLOAD_MAX_SIZE=5242880
